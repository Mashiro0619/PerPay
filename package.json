{
  "name": "perpay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "npm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "check": "npm run check:version && npm run typecheck && npm run test:node && npm run build:server",
    "check:version": "node scripts/check-version.mjs",
    "dev": "node --experimental-strip-types --watch src/main.ts",
    "start": "node dist/main.js",
    "test": "npm run test:node",
    "test:node": "node --experimental-strip-types --test --test-isolation=process test/**/*.test.ts test/**/*.test.mjs",
    "typecheck": "npm run typecheck:server",
    "typecheck:server": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "hono": "4.13.2",
    "uqr": "0.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}
