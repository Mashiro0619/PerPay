{
  "name": "perpay",
  "version": "1.0.0-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "demo:package": "node scripts/package-client-demo.mjs",
    "build": "npm run build:admin && npm run build:checkout && npm run build:server",
    "build:admin": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "check": "npm run check:version && npm run api:check && npm run typecheck && npm run test && npm run build:server",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "check:version": "node scripts/check-version.mjs",
    "dev": "node --experimental-strip-types --watch src/main.ts",
    "dev:admin": "vite --config web/vite.config.ts",
    "start": "node dist/main.js",
    "test": "npm run test:node && npm run test:admin",
    "pretest": "npm run build:admin && npm run build:checkout",
    "test:admin": "vitest run --config web/vite.config.ts",
    "test:node": "node --experimental-strip-types --test --test-isolation=process test/**/*.test.ts test/**/*.test.mjs",
    "typecheck": "npm run typecheck:server && npm run typecheck:admin && npm run typecheck:ui",
    "typecheck:ui": "tsc --project tsconfig.ui.json",
    "typecheck:admin": "tsc --project web/tsconfig.json",
    "typecheck:server": "tsc --noEmit",
    "build:checkout": "vite build --config web/vite.checkout.config.ts && vite build --config web/vite.checkout.config.ts --mode server",
    "demo:preview": "node --experimental-strip-types scripts/preview-demo.ts",
    "test:ui": "playwright test",
    "test:ui:full": "playwright test --config playwright.config.ts --project full"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hono/node-server": "2.1.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "hono": "4.13.13",
    "recharts": "^3.10.1",
    "tw-animate-css": "1.4.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "9.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "jsqr": "1.4.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
