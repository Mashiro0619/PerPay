# PerPay 来源，不要加 /admin 或 /api；远端必须 HTTPS，本机可 HTTP。
PERPAY_URL=http://127.0.0.1:6190
# PerPay 管理后台「密钥与安全」的网站 API 密钥，不是管理员密码或支付宝私钥。
PERPAY_API_SECRET=
DEMO_PORT=6196
# 可选。使用通知时同时填写下面两项；不使用时两项均留空。
# 在 PerPay 允许的通知 Origin 中填写对应的 https://shop.example.com。
DEMO_NOTIFY_URL=
PERPAY_WEBHOOK_SECRET=
# 相对本示例目录，记录订单参数与通知去重；不要提交或分享此目录。
DEMO_DATA_DIR=data
