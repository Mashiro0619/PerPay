# PerPay 来源，不要加 /admin 或 /api；远端必须 HTTPS，本机可 HTTP。
PERPAY_URL=http://localhost:6190
# 从 PerPay“业务网站”页面复制；升级保留的旧网站才使用 default。
PERPAY_CLIENT_ID=
# PerPay 管理后台「密钥与安全」的网站 API 密钥，不是管理员密码或支付宝私钥。
PERPAY_API_SECRET=
# 必填：你的 HTTPS 回调地址，只将此路径转发到 Demo，不要公开整个示例。
# 在 PerPay 启用业务通知，允许的 Origin 填 https://你的业务域名（不含路径）。
DEMO_NOTIFY_URL=https://shop.example.com/webhooks/perpay
# 单密钥兼容模式：PerPay 的通知签名密钥，不是上面的网站 API 密钥。
# 与下方 PERPAY_WEBHOOK_KEYS 二选一，不能同时填写。
PERPAY_WEBHOOK_SECRET=
# 按 key-id 验签，可配置当前与上一把密钥（最多两把）；key-id 从可信后台投递详情取得。
# 例：PERPAY_WEBHOOK_KEYS='{"11111111-1111-4111-8111-111111111111":"当前密钥","22222222-2222-4222-8222-222222222222":"上一把密钥"}'
PERPAY_WEBHOOK_KEYS=
# 本机演示端口，按需修改。
DEMO_PORT=6196
# 相对本示例目录，记录订单参数与通知去重；不要提交或分享此目录。
DEMO_DATA_DIR=data
